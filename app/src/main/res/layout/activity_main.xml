<?xml version="1.0" encoding="utf-8"?>
<com.signaldeck.scope.SlideFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slideRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B08">

    <!-- ================= MAIN APP (screen 1) ================= -->
    <LinearLayout
        android:id="@+id/mainPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:background="#0D150E">

            <TextView
                android:id="@+id/menuBtnMain"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:text="☰"
                android:textColor="#4DFFA0"
                android:textSize="20sp"
                android:background="#123524" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingStart="12dp"
                android:text="SIGNAL DECK — SCOPE"
                android:textColor="#6F9A80"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#070B08">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIGNAL DECK"
                    android:textColor="#4DFFA0"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NATIVE USB SCOPE PANEL"
                    android:textColor="#6F9A80"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#0D150E"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/connStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Not connected"
                        android:textColor="#FF5A5A" />

                    <Button
                        android:id="@+id/connectBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connect" />
                </LinearLayout>

                <com.signaldeck.scope.ScopeView
                    android:id="@+id/scopeView"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pinch to zoom · drag to pan (captured mode only)"
                    android:textColor="#6F9A80"
                    android:textSize="9.5sp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button android:id="@+id/zoomOutBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Zoom −" android:textSize="11sp" />
                    <Button android:id="@+id/resetZoomBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Reset" android:textSize="11sp" />
                    <Button android:id="@+id/zoomInBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Zoom +" android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/rVoltage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Voltage: -- (no real capture yet)"
                    android:textColor="#4DFFA0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/rRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rate: --"
                    android:textColor="#6F9A80"
                    android:textSize="10.5sp"
                    android:layout_marginBottom="12dp" />

                <!-- ===== FREQUENCY KNOB SECTION ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FREQUENCY CONTROL"
                    android:textColor="#6F9A80"
                    android:textSize="10.5sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/rTargetBig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1000.00 Hz"
                    android:textColor="#4DFFA0"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <com.signaldeck.scope.DialView
                    android:id="@+id/dialView"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Drag the knob — needle follows your finger 1:1 · 270° sweep = full range"
                    android:textColor="#6F9A80"
                    android:textSize="9.5sp"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button android:id="@+id/coarseModeBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Linear" android:textSize="12sp" />
                    <Button android:id="@+id/fineModeBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Log" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button android:id="@+id/downFreqBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="◀ Hold" android:textSize="12sp" />
                    <Button android:id="@+id/speed1xBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="1×" android:textSize="12sp" />
                    <Button android:id="@+id/speed2xBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="2×" android:textSize="12sp" />
                    <Button android:id="@+id/upFreqBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Hold ▶" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button android:id="@+id/minus1Btn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="−1 Hz" android:textSize="12sp" />
                    <Button android:id="@+id/minus01Btn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="−0.1 Hz" android:textSize="11sp" />
                    <Button android:id="@+id/plus01Btn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="+0.1 Hz" android:textSize="11sp" />
                    <Button android:id="@+id/plus1Btn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="+1 Hz" android:textSize="12sp" />
                </LinearLayout>
                <!-- ===== END KNOB SECTION ===== -->

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:layout_marginBottom="12dp">

                    <TextView android:id="@+id/rTarget" android:layout_width="0dp" android:layout_columnWeight="1"
                        android:layout_height="wrap_content" android:text="Target: --" android:textColor="#4DFFA0" android:padding="6dp" />
                    <TextView android:id="@+id/rMeasured" android:layout_width="0dp" android:layout_columnWeight="1"
                        android:layout_height="wrap_content" android:text="Measured: --" android:textColor="#4DFFA0" android:padding="6dp" />
                    <TextView android:id="@+id/rDuty" android:layout_width="0dp" android:layout_columnWeight="1"
                        android:layout_height="wrap_content" android:text="Duty: --" android:textColor="#4DFFA0" android:padding="6dp" />
                </GridLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button android:id="@+id/liveCaptureBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Start Live Capture" />
                    <Button android:id="@+id/reconBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Reconstructed" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/cmdInput"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="type command, e.g. D"
                        android:textColor="#BFE8CD"
                        android:textColorHint="#6F9A80"
                        android:inputType="text"
                        android:imeOptions="actionSend" />

                    <Button
                        android:id="@+id/sendBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Send" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="LOG"
                        android:textColor="#6F9A80"
                        android:textSize="10.5sp" />

                    <Button
                        android:id="@+id/clearLogBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear Log"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/logView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="200dp"
                    android:background="#0D150E"
                    android:padding="10dp"
                    android:textColor="#4DFFA0"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ================= LOGBOOK (screen 2) ================= -->
    <LinearLayout
        android:id="@+id/logbookPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#070B08"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:background="#0D150E">

            <TextView
                android:id="@+id/menuBtnLog"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:text="☰"
                android:textColor="#4DFFA0"
                android:textSize="20sp"
                android:background="#123524" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingStart="12dp"
                android:text="SIGNAL DECK — LOGBOOK"
                android:textColor="#6F9A80"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Swipe from the left edge (or tap ☰) to open the menu.\nEvery app action + every line from the Uno, timestamped.\nOne .txt file per connection — tap a saved file below to open it."
                android:textColor="#6F9A80"
                android:textSize="9.5sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/liveBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="● LIVE"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/refreshFilesBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Refresh files"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/viewerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Live session"
                android:textColor="#FFB347"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#0D150E">

                <ScrollView
                    android:id="@+id/logbookScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <TextView
                        android:id="@+id/logbookView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:textColor="#4DFFA0"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:textIsSelectable="true" />
                </ScrollView>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingStart="12dp"
            android:paddingRight="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAVED SESSIONS"
                android:textColor="#6F9A80"
                android:textSize="10.5sp"
                android:layout_marginBottom="4dp" />

            <ScrollView
                android:id="@+id/sessionsScroll"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="#0D150E">

                <LinearLayout
                    android:id="@+id/sessionsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= SCRIM (dark overlay behind the drawer) ================= -->
    <View
        android:id="@+id/scrimView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <!-- ================= DRAWER (the menu window) ================= -->
    <LinearLayout
        android:id="@+id/drawerView"
        android:layout_width="230dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0D150E"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NAVIGATE"
            android:textColor="#6F9A80"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/drawerMainOpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="#123524"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAIN APP"
                android:textColor="#4DFFA0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="scope + frequency controls"
                android:textColor="#6F9A80"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawerLogOpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="#00000000"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOGBOOK"
                android:textColor="#BFE8CD"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="timestamped session files"
                android:textColor="#6F9A80"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</com.signaldeck.scope.SlideFrameLayout>
