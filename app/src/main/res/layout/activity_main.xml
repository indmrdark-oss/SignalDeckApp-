<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- CONNECTION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/connStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disconnected"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:padding="10dp"/>

            <Button
                android:id="@+id/connectBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect"/>
        </LinearLayout>

        <!-- SCOPE -->

        <com.signaldeck.scope.ScopeView
            android:id="@+id/scopeView"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="10dp"/>

        <!-- TARGET -->

        <TextView
            android:id="@+id/rTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target: 1000.00 Hz"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/rTargetBig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1000.00 Hz"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="6dp"/>

        <!-- DIAL -->

        <com.signaldeck.scope.DialView
            android:id="@+id/dialView"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="8dp"/>

        <!-- DIAL MODES -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/coarseModeBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="COARSE"/>

            <Button
                android:id="@+id/fineModeBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FINE"/>
        </LinearLayout>

        <!-- ARROW SPEED -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ARROW SPEED"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/speed1xBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1×"/>

            <Button
                android:id="@+id/speed2xBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2×"/>
        </LinearLayout>

        <!-- UP / DOWN -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/downFreqBtn"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:text="▼"
                android:textSize="28sp"/>

            <Button
                android:id="@+id/upFreqBtn"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:text="▲"
                android:textSize="28sp"/>
        </LinearLayout>

        <!-- EXACT NUDGE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/minus1Btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-1 Hz"/>

            <Button
                android:id="@+id/minus01Btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-0.1 Hz"/>

            <Button
                android:id="@+id/plus01Btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+0.1 Hz"/>

            <Button
                android:id="@+id/plus1Btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+1 Hz"/>
        </LinearLayout>

        <!-- MEASUREMENTS -->

        <TextView
            android:id="@+id/rMeasured"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Measured: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="6dp"/>

        <TextView
            android:id="@+id/rDuty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Duty: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="6dp"/>

        <TextView
            android:id="@+id/rRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rate: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="6dp"/>

        <TextView
            android:id="@+id/rVoltage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltage: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="6dp"/>

        <!-- CAPTURE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/liveCaptureBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start Live Capture"/>

            <Button
                android:id="@+id/reconBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reconstructed"/>
        </LinearLayout>

        <!-- COMMAND -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <EditText
                android:id="@+id/cmdInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Command"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:singleLine="true"/>

            <Button
                android:id="@+id/sendBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEND"/>
        </LinearLayout>

        <!-- LOG -->

        <Button
            android:id="@+id/clearLogBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear Log"/>

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#080808"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:padding="8dp"
            android:scrollbars="vertical"/>

    </LinearLayout>

</ScrollView>
